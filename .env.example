# Copie para .env e ajuste. Todos os valores têm default no docker-compose.yml.
RABBITMQ_USER=bank
RABBITMQ_PASSWORD=bank

ACCOUNT_DB_PASSWORD=account
TRANSFER_DB_PASSWORD=transfer
NOTIFICATION_DB_PASSWORD=notification

# Segredo HS256 do JWT de login (mínimo 32 caracteres) — troque fora de ambiente de desenvolvimento
BANK_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# 0.0 a 1.0 — simula falhas do provedor de notificação para demonstrar Retry/DLQ/auditoria
NOTIFICATION_FAILURE_RATE=0.0
